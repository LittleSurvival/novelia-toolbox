{
    "name": "novelia-toolbox",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "vite --mode development",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "build": "npm run typecheck && vite build",
        "format": "prettier --write src tests vite.config.ts vitest.config.ts package.json tsconfig.json .prettierrc.json",
        "format:check": "prettier --check src tests vite.config.ts vitest.config.ts package.json tsconfig.json .prettierrc.json",
        "preview": "vite preview"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "jsdom": "29.1.1",
        "prettier": "3.9.9",
        "typescript": "7.0.2",
        "vite": "8.3.3",
        "vite-plugin-monkey": "8.1.1",
        "vitest": "5.0.3"
    }
}
